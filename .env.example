# 复制为 .env 后填入真实值

# 模型：OpenAI 兼容端点
OPENAI_BASE_URL=http://your-endpoint/v1
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-5.6-sol
# 画图子 agent 使用的模型，需要端点支持 images.generate 接口
AGENT_IMAGE_MODEL=gpt-image-1

# 联网搜索：https://app.tavily.com 申请
TAVILY_API_KEY=tvly-...

# NAS：save_md2nas 工具通过 SFTP 写文件
nas_host=192.168.1.x
nas_username=your-name
nas_password=your-password
